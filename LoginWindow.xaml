<Window x:Class="Catalyst_Launcher.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catalyst - Sign in"
        Width="520" Height="660"
        MinWidth="520" MinHeight="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontDisplay}"
        Foreground="{StaticResource ChalkBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background"       Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground"       Value="{StaticResource ChalkBrush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="10,8"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="CaretBrush"       Value="{StaticResource BrassBrush}"/>
            <Setter Property="PasswordChar"     Value="*"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SlateBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrassBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthTab" TargetType="RadioButton">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource SlateBrush}"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontDisplay}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="0,0,0,11"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                                    Background="{StaticResource BrassBrush}"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource SlateBrush}"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontDisplay}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FontSize"         Value="11.5"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Tb" Background="Transparent"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tb" Property="Foreground"
                                        Value="{StaticResource BrassBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

    </Window.Resources>

    <Border Background="{StaticResource SheetBrush}"
            BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Rectangle Fill="{StaticResource DraftingGridBrush}" IsHitTestVisible="False"/>

            <DockPanel LastChildFill="True">

                <Border DockPanel.Dock="Top"
                        Background="{StaticResource RailBrush}"
                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1"
                        Height="34"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                            <Path Width="16" Height="16" Stretch="None"
                                  Data="M2,14 L14,14 L14,2 Z M5.2,12.8 L12.8,12.8 L12.8,5.2 Z"
                                  Stroke="{StaticResource BrassBrush}" StrokeThickness="1.2"
                                  StrokeLineJoin="Round" SnapsToDevicePixels="True"/>
                            <TextBlock Text="CATALYST" Margin="10,0,0,0"
                                       FontSize="11.5" FontWeight="Bold" FontStretch="SemiCondensed"
                                       Foreground="{StaticResource ChalkBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="LAUNCHER" Margin="6,0,0,0"
                                       FontFamily="{StaticResource FontMono}" FontSize="9.5"
                                       Foreground="{StaticResource SlateBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource TitleCloseBtn}"
                                HorizontalAlignment="Right" Click="Close_Click" ToolTip="Close">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="56,0,56,36">

                        <!-- Identity plate -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,44,0,34">
                            <Border Width="54" Height="54"
                                    Background="{StaticResource FieldBrush}"
                                    BorderBrush="{StaticResource BrassBrush}" BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Path Width="30" Height="30" Stretch="Uniform"
                                      Data="M2,14 L14,14 L14,2 Z M5.2,12.8 L12.8,12.8 L12.8,5.2 Z"
                                      Stroke="{StaticResource BrassBrush}" StrokeThickness="0.9"
                                      StrokeLineJoin="Round"/>
                            </Border>
                            <TextBlock Text="CATALYST ENGINE"
                                       HorizontalAlignment="Center" Margin="0,16,0,0"
                                       FontSize="16" FontWeight="Bold" FontStretch="SemiCondensed"
                                       Foreground="{StaticResource ChalkBrush}"/>
                            <TextBlock Text="RELEASE 1.0"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                       FontFamily="{StaticResource FontMono}" FontSize="10"
                                       Foreground="{StaticResource SlateBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <RadioButton x:Name="TabLogin" Content="Sign in"
                                         Style="{StaticResource AuthTab}" GroupName="AuthTabs"
                                         IsChecked="True" Margin="0,0,30,0"
                                         Checked="TabLogin_Checked"/>
                            <RadioButton x:Name="TabRegister" Content="Create account"
                                         Style="{StaticResource AuthTab}" GroupName="AuthTabs"
                                         Checked="TabRegister_Checked"/>
                        </StackPanel>
                        <Rectangle Height="1" Fill="{StaticResource RuleBrush}" Margin="0,0,0,26"
                                   SnapsToDevicePixels="True"/>

                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL"/>
                            <TextBox x:Name="LoginEmail" Style="{StaticResource DarkTextBox}"
                                     Height="38" Margin="0,0,0,16"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="PASSWORD"/>
                            <PasswordBox x:Name="LoginPassword" Style="{StaticResource DarkPasswordBox}"
                                         Height="38" Margin="0,0,0,8"
                                         KeyDown="Password_KeyDown"/>

                            <Button Content="Forgot your password?"
                                    Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,24"
                                    Click="ForgotPassword_Click"/>

                            <Button x:Name="LoginBtn" Content="Sign in"
                                    Style="{StaticResource OrangeButton}"
                                    Height="42" FontSize="13.5"
                                    Click="Login_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="USERNAME"/>
                            <TextBox x:Name="RegUsername" Style="{StaticResource DarkTextBox}"
                                     Height="38" Margin="0,0,0,16"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL"/>
                            <TextBox x:Name="RegEmail" Style="{StaticResource DarkTextBox}"
                                     Height="38" Margin="0,0,0,16"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="PASSWORD"/>
                            <PasswordBox x:Name="RegPassword" Style="{StaticResource DarkPasswordBox}"
                                         Height="38" Margin="0,0,0,16"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="CONFIRM PASSWORD"/>
                            <PasswordBox x:Name="RegConfirmPassword" Style="{StaticResource DarkPasswordBox}"
                                         Height="38" Margin="0,0,0,24"
                                         KeyDown="Password_KeyDown"/>

                            <Button x:Name="RegisterBtn" Content="Create account"
                                    Style="{StaticResource OrangeButton}"
                                    Height="42" FontSize="13.5"
                                    Click="Register_Click"/>
                        </StackPanel>

                        <Border x:Name="StatusFrame" Visibility="Collapsed"
                                Margin="0,14,0,0" Padding="12,9"
                                Background="{StaticResource FieldBrush}"
                                BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="StatusLabel"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <Grid Margin="0,30,0,22">
                            <Rectangle Height="1" Fill="{StaticResource RuleBrush}"
                                       SnapsToDevicePixels="True"/>
                            <Border Background="{StaticResource SheetBrush}"
                                    Padding="14,0" HorizontalAlignment="Center">
                                <TextBlock Text="OR" FontFamily="{StaticResource FontMono}" FontSize="10"
                                           Foreground="{StaticResource SlateBrush}"/>
                            </Border>
                        </Grid>

                        <Button Content="Keep working offline"
                                Style="{StaticResource GhostButton}"
                                Height="40" FontSize="12.5"
                                Click="ContinueOffline_Click"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="11"
                                   Foreground="{StaticResource SlateBrush}"
                                   TextAlignment="Center" Margin="0,10,0,0"
                                   Text="Your projects live on this machine either way. Signing in only syncs your account."/>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
