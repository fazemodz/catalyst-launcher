<Application x:Class="Catalyst_Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Catalyst_Launcher.UI"
             Startup="App_Startup">
    <Application.Resources>

        <!-- =====================================================================
             CATALYST LAUNCHER  /  CYANOTYPE
             The launcher is a drafting sheet: ink-blue ground, chalk rules,
             DIN lettering, a real title block. Colour carries state and nothing
             else. No gradients, no rounded corners, no emoji.
             ===================================================================== -->

        <!-- Ground -->
        <SolidColorBrush x:Key="InkBrush"        Color="#06121A"/>
        <SolidColorBrush x:Key="SheetBrush"      Color="#0A1C28"/>
        <SolidColorBrush x:Key="PlateBrush"      Color="#0E2432"/>
        <SolidColorBrush x:Key="PlateHiBrush"    Color="#143242"/>
        <SolidColorBrush x:Key="FieldBrush"      Color="#071620"/>
        <SolidColorBrush x:Key="RailBrush"       Color="#081722"/>

        <!-- Rules -->
        <SolidColorBrush x:Key="RuleBrush"       Color="#1D4055"/>
        <SolidColorBrush x:Key="RuleSoftBrush"   Color="#14303F"/>

        <!-- Lettering -->
        <SolidColorBrush x:Key="ChalkBrush"      Color="#E4EFF5"/>
        <SolidColorBrush x:Key="GraphiteBrush"   Color="#7EA1B6"/>
        <SolidColorBrush x:Key="SlateBrush"      Color="#63899F"/>

        <!-- Signals. Brass marks the live thing, verdigris reads OK,
             redline is reserved for faults and corrections. -->
        <SolidColorBrush x:Key="BrassBrush"      Color="#DFA24B"/>
        <SolidColorBrush x:Key="VerdigrisBrush"  Color="#4FA48D"/>
        <SolidColorBrush x:Key="RedlineBrush"    Color="#D2543C"/>

        <!-- Legend inks -->
        <SolidColorBrush x:Key="InkCyanBrush"    Color="#6FB6D8"/>
        <SolidColorBrush x:Key="InkVioletBrush"  Color="#B08BD8"/>
        <SolidColorBrush x:Key="InkBronzeBrush"  Color="#C08A5A"/>

        <!-- Compatibility keys. Same palette, older names. -->
        <SolidColorBrush x:Key="BgDeepBrush"        Color="#06121A"/>
        <SolidColorBrush x:Key="BgPanelBrush"       Color="#0E2432"/>
        <SolidColorBrush x:Key="BgSidebarBrush"     Color="#0A1C28"/>
        <SolidColorBrush x:Key="BgCardBrush"        Color="#0E2432"/>
        <SolidColorBrush x:Key="AccentOrangeBrush"  Color="#DFA24B"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#E4EFF5"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7EA1B6"/>
        <SolidColorBrush x:Key="TextMutedBrush"     Color="#63899F"/>
        <SolidColorBrush x:Key="StrokeBrush"        Color="#1D4055"/>
        <SolidColorBrush x:Key="StrokeSoftBrush"    Color="#14303F"/>
        <SolidColorBrush x:Key="WindowBg"      Color="#06121A"/>
        <SolidColorBrush x:Key="SidebarBg"     Color="#0A1C28"/>
        <SolidColorBrush x:Key="CardBg"        Color="#0E2432"/>
        <SolidColorBrush x:Key="CardHover"     Color="#143242"/>
        <SolidColorBrush x:Key="AccentBrush"   Color="#DFA24B"/>
        <SolidColorBrush x:Key="DividerBrush"  Color="#1D4055"/>
        <SolidColorBrush x:Key="PrimaryText"   Color="#E4EFF5"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#7EA1B6"/>
        <SolidColorBrush x:Key="MutedText"     Color="#63899F"/>
        <SolidColorBrush x:Key="GreenBg"       Color="#1A3B36"/>
        <SolidColorBrush x:Key="GreenHover"    Color="#245049"/>

        <!-- =====================================================================
             LETTERING
             Bahnschrift is DIN 1451, the engineering-drawing letter. Cascadia
             carries every measured value: paths, versions, dates, counts.
             ===================================================================== -->
        <FontFamily x:Key="FontDisplay">Bahnschrift, Segoe UI</FontFamily>
        <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>

        <!-- =====================================================================
             DRAFTING PAPER
             48px major squares, 12px minor. Barely there; it should read as
             paper, not as a pattern.
             ===================================================================== -->
        <DrawingBrush x:Key="DraftingGridBrush"
                      TileMode="Tile" Stretch="None"
                      Viewport="0,0,48,48" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#0E2E6488" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="12,0" EndPoint="12,48"/>
                                <LineGeometry StartPoint="24,0" EndPoint="24,48"/>
                                <LineGeometry StartPoint="36,0" EndPoint="36,48"/>
                                <LineGeometry StartPoint="0,12" EndPoint="48,12"/>
                                <LineGeometry StartPoint="0,24" EndPoint="48,24"/>
                                <LineGeometry StartPoint="0,36" EndPoint="48,36"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#243E7CB0" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="48,0"/>
                                <LineGeometry StartPoint="0,0" EndPoint="0,48"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- =====================================================================
             INSTRUMENT MARKS
             Drawn on a 16px square, stroked, never filled.
             ===================================================================== -->
        <StreamGeometry x:Key="IconSearch">M3,7 A4,4 0 1 1 11,7 A4,4 0 1 1 3,7 M9.9,9.9 L14,14</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M1.5,3.5 L6,3.5 L7.6,5.8 L14.5,5.8 L14.5,12.5 L1.5,12.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPlus">M8,3 L8,13 M3,8 L13,8</StreamGeometry>
        <StreamGeometry x:Key="IconGrid">M2.5,2.5 H7 V7 H2.5 Z M9,2.5 H13.5 V7 H9 Z M2.5,9 H7 V13.5 H2.5 Z M9,9 H13.5 V13.5 H9 Z</StreamGeometry>
        <StreamGeometry x:Key="IconList">M2.5,4 H13.5 M2.5,8 H13.5 M2.5,12 H13.5</StreamGeometry>
        <StreamGeometry x:Key="IconSort">M3,4 H13 M4.5,8 H11.5 M6.5,12 H9.5</StreamGeometry>
        <StreamGeometry x:Key="IconNut">M8,1.6 L13.5,4.8 V11.2 L8,14.4 L2.5,11.2 V4.8 Z M5.6,8 A2.4,2.4 0 1 1 10.4,8 A2.4,2.4 0 1 1 5.6,8</StreamGeometry>
        <StreamGeometry x:Key="IconMinimize">M3.5,8 H12.5</StreamGeometry>
        <StreamGeometry x:Key="IconMaximize">M3.5,3.5 H12.5 V12.5 H3.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M4,4 L12,12 M12,4 L4,12</StreamGeometry>
        <StreamGeometry x:Key="IconSheets">M3,2.5 H9.5 L13,6 V13.5 H3 Z M9.5,2.5 V6 H13</StreamGeometry>
        <StreamGeometry x:Key="IconFlag">M4,2 V14.2 M4,2.8 H12 L10,5.8 L12,8.8 H4</StreamGeometry>
        <StreamGeometry x:Key="IconClock">M2.2,8 A5.8,5.8 0 1 1 13.8,8 A5.8,5.8 0 1 1 2.2,8 M8,4.6 V8.2 L10.4,9.6</StreamGeometry>
        <StreamGeometry x:Key="IconLayers">M8,2 L14,5.3 L8,8.6 L2,5.3 Z M2,9 L8,12.3 L14,9</StreamGeometry>
        <StreamGeometry x:Key="IconCloud">M4.6,12 A2.9,2.9 0 0 1 5,6.3 A3.7,3.7 0 0 1 11.9,6.6 A2.7,2.7 0 0 1 11.6,12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconArrow">M3,8 H12.4 M8.8,4.4 L12.4,8 L8.8,11.6</StreamGeometry>
        <StreamGeometry x:Key="IconChevron">M6,3.5 L10.5,8 L6,12.5</StreamGeometry>
        <StreamGeometry x:Key="IconBook">M2.5,3 H6.6 A1.4,1.4 0 0 1 8,4.4 A1.4,1.4 0 0 1 9.4,3 H13.5 V12.4 H9.4 A1.4,1.4 0 0 0 8,13.8 A1.4,1.4 0 0 0 6.6,12.4 H2.5 Z M8,4.4 V13.8</StreamGeometry>
        <StreamGeometry x:Key="IconNodes">M1.5,4 H6 V9 H1.5 Z M10,7 H14.5 V12 H10 Z M6,6.5 H8 V9.5 H10</StreamGeometry>
        <StreamGeometry x:Key="IconChip">M4.5,4.5 H11.5 V11.5 H4.5 Z M6.5,1.6 V4.5 M9.5,1.6 V4.5 M6.5,11.5 V14.4 M9.5,11.5 V14.4 M1.6,6.5 H4.5 M1.6,9.5 H4.5 M11.5,6.5 H14.4 M11.5,9.5 H14.4</StreamGeometry>
        <StreamGeometry x:Key="IconBox">M8,1.8 L14,5 V11 L8,14.2 L2,11 V5 Z M2,5 L8,8.2 L14,5 M8,8.2 V14.2</StreamGeometry>
        <StreamGeometry x:Key="IconSphere">M2.2,8 A5.8,5.8 0 1 1 13.8,8 A5.8,5.8 0 1 1 2.2,8 M2.2,8 A5.8,2.9 0 0 0 13.8,8 M8,2.2 A2.9,5.8 0 0 0 8,13.8</StreamGeometry>
        <StreamGeometry x:Key="IconCamera">M1.8,5 H5 L6.2,3.2 H9.8 L11,5 H14.2 V12.6 H1.8 Z M5.8,8.8 A2.2,2.2 0 1 1 10.2,8.8 A2.2,2.2 0 1 1 5.8,8.8</StreamGeometry>
        <StreamGeometry x:Key="IconTerminal">M2.2,2.6 H13.8 V13.4 H2.2 Z M5,6 L7.4,8 L5,10 M8.6,10.4 H11.4</StreamGeometry>
        <StreamGeometry x:Key="IconMonitor">M1.6,3 H14.4 V11 H1.6 Z M6,13.8 H10 M8,11 V13.8</StreamGeometry>
        <StreamGeometry x:Key="IconFlask">M6.4,1.8 V6.4 L3,12.6 A1,1 0 0 0 3.9,14.1 H12.1 A1,1 0 0 0 13,12.6 L9.6,6.4 V1.8 M5.4,1.8 H10.6 M4.5,10.2 H11.5</StreamGeometry>
        <StreamGeometry x:Key="IconCart">M1.6,2.6 H3.6 L5.6,10.6 H12.6 L14.2,5.2 H4.3 M5.7,13 A0.95,0.95 0 1 1 7.6,13 A0.95,0.95 0 1 1 5.7,13 M10.4,13 A0.95,0.95 0 1 1 12.3,13 A0.95,0.95 0 1 1 10.4,13</StreamGeometry>
        <StreamGeometry x:Key="IconChat">M1.8,3 H14.2 V11 H7.6 L4.4,14 V11 H1.8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconUser">M5.4,5.2 A2.6,2.6 0 1 1 10.6,5.2 A2.6,2.6 0 1 1 5.4,5.2 M2.4,14 A5.6,5.6 0 0 1 13.6,14</StreamGeometry>
        <StreamGeometry x:Key="IconBranch">M4.5,4 A1.6,1.6 0 1 1 7.7,4 A1.6,1.6 0 1 1 4.5,4 M8.3,12 A1.6,1.6 0 1 1 11.5,12 A1.6,1.6 0 1 1 8.3,12 M6.1,5.6 V10 A2,2 0 0 0 8.1,12</StreamGeometry>
        <StreamGeometry x:Key="IconDiamond">M8,1.8 L14.2,8 L8,14.2 L1.8,8 Z</StreamGeometry>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stroke"
                    Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
            <Setter Property="StrokeThickness"     Value="1.25"/>
            <Setter Property="StrokeStartLineCap"  Value="Round"/>
            <Setter Property="StrokeEndLineCap"    Value="Round"/>
            <Setter Property="StrokeLineJoin"      Value="Round"/>
            <Setter Property="Width"               Value="16"/>
            <Setter Property="Height"              Value="16"/>
            <Setter Property="Stretch"             Value="None"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Keyboard focus: a dashed brass ring, the way a drawing is marked up -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="#DFA24B" StrokeThickness="1"
                                   StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================================
             TYPE ROLES
             ===================================================================== -->

        <!-- Field caption. Sits above every measured value, like a title block cell. -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize"    Value="9"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="{StaticResource SlateBrush}"/>
            <Setter Property="ui:Tracking.Amount" Value="1.1"/>
        </Style>

        <!-- Measured value: paths, versions, dates, counts. -->
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
        </Style>

        <Style x:Key="SheetTitle" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize"     Value="22"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="FontStretch"  Value="SemiCondensed"/>
            <Setter Property="Foreground"   Value="{StaticResource ChalkBrush}"/>
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{StaticResource GraphiteBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight"   Value="18"/>
        </Style>

        <Style x:Key="SidebarSection" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="18,20,0,8"/>
        </Style>

        <!-- =====================================================================
             TITLE RAIL
             ===================================================================== -->
        <Style x:Key="TopTab" TargetType="RadioButton">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource SlateBrush}"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontDisplay}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="14,0"/>
            <Setter Property="Height"           Value="34"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ActiveBar" Height="2" VerticalAlignment="Bottom"
                                    Background="{StaticResource BrassBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleIconBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource SlateBrush}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Width"            Value="40"/>
            <Setter Property="Height"           Value="34"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PlateHiBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleIconBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource RedlineBrush}"/>
                                <Setter Property="Foreground" Value="#0A1520"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================================
             INDEX RAIL
             ===================================================================== -->
        <Style x:Key="SidebarNav" TargetType="RadioButton">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource GraphiteBrush}"/>
            <Setter Property="FontFamily"                 Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize"                   Value="12.5"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Height"                     Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="FocusVisualStyle"           Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="Mark" Width="2" HorizontalAlignment="Left"
                                        Background="{StaticResource BrassBrush}" Visibility="Collapsed"/>
                                <ContentPresenter Margin="18,0,12,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg"   Property="Background" Value="{StaticResource PlateBrush}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0C2532"/>
                                <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Legend row: swatch plus what it means -->
        <Style x:Key="SidebarTag" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource GraphiteBrush}"/>
            <Setter Property="FontFamily"                 Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Height"                     Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="18,0"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="FocusVisualStyle"           Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0C2532"/>
                                <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallIconBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource SlateBrush}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Width"            Value="30"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PlateHiBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================================
             ACTIONS
             One primary: a chalk plate, the way a white label reads against a
             cyanotype. Everything else is a ruled outline.
             ===================================================================== -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource GraphiteBrush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontDisplay}"/>
            <Setter Property="Padding"          Value="14,7"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="{StaticResource PlateHiBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource SlateBrush}"/>
                                <Setter Property="Foreground"  Value="{StaticResource ChalkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"  Value="#3E6274"/>
                                <Setter Property="BorderBrush" Value="{StaticResource RuleSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Background"       Value="{StaticResource ChalkBrush}"/>
            <Setter Property="Foreground"       Value="#06121A"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontDisplay}"/>
            <Setter Property="Padding"          Value="18,8"/>
            <Setter Property="FontSize"         Value="12.5"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#A9C4D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource RuleSoftBrush}"/>
                                <Setter Property="Foreground" Value="#4A7288"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonV2" TargetType="Button" BasedOn="{StaticResource OrangeButton}">
            <Setter Property="Padding" Value="22,9"/>
        </Style>

        <Style x:Key="ViewToggle" TargetType="RadioButton">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource SlateBrush}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Width"            Value="32"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PlateHiBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CatItem" TargetType="RadioButton" BasedOn="{StaticResource SidebarNav}">
            <Setter Property="Height"   Value="34"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="SidebarActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height"  Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <!-- Card action: a small ruled plate that fills on hover -->
        <Style x:Key="CardOpenButton" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="{StaticResource GraphiteBrush}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="FontFamily"        Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="Padding"           Value="10,4"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle"  Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="{StaticResource ChalkBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ChalkBrush}"/>
                                <Setter Property="Foreground"  Value="#06121A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"  Value="#3E6274"/>
                                <Setter Property="BorderBrush" Value="{StaticResource RuleSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================================
             INPUTS
             ===================================================================== -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"       Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground"       Value="{StaticResource ChalkBrush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="10,8"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="CaretBrush"       Value="{StaticResource BrassBrush}"/>
            <Setter Property="SelectionBrush"   Value="{StaticResource BrassBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SlateBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrassBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegOpt" TargetType="RadioButton">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource GraphiteBrush}"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontMono}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ChalkBrush}"/>
                                <Setter Property="Foreground" Value="#06121A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PlateHiBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"       Value="{StaticResource ChalkBrush}"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15"
                                    Background="{StaticResource FieldBrush}"
                                    BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="Check" Visibility="Collapsed"
                                      Data="M2.5,6.6 L5.4,9.5 L10.4,3.8"
                                      Stroke="{StaticResource BrassBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="None"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box"   Property="BorderBrush" Value="{StaticResource BrassBrush}"/>
                                <Setter TargetName="Check" Property="Visibility"  Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SlateBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#3E6274"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource RuleSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================================
             SCROLLBAR
             A margin tick, not a chrome widget.
             ===================================================================== -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Background="#255468" Margin="3,0"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="{StaticResource SlateBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="10"/>
                                <Setter Property="Width"  Value="Auto"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================================
             MARKUP MENU
             ===================================================================== -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background"      Value="{StaticResource PlateBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="0,4"/>
            <Setter Property="FontFamily"      Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{StaticResource ChalkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                MinWidth="186"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#02090F" BlurRadius="24" ShadowDepth="8" Opacity="0.7"/>
                            </Border.Effect>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="Transparent">
                            <Grid Margin="14,0,12,0">
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <Path x:Name="Arrow" Style="{StaticResource Icon}"
                                      Data="{StaticResource IconChevron}"
                                      Stroke="{StaticResource SlateBrush}"
                                      HorizontalAlignment="Right"
                                      Visibility="Collapsed"/>
                                <Popup x:Name="SubMenuPopup"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       Placement="Right"
                                       HorizontalOffset="-2"
                                       VerticalOffset="-8"
                                       PopupAnimation="None">
                                    <Border Background="{StaticResource PlateBrush}"
                                            BorderBrush="{StaticResource RuleBrush}"
                                            BorderThickness="1"
                                            Padding="0,4" MinWidth="168"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#02090F" BlurRadius="24" ShadowDepth="8" Opacity="0.7"/>
                                        </Border.Effect>
                                        <ItemsPresenter/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PlateHiBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#3E6274"/>
                                <Setter Property="Cursor"     Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource RuleSoftBrush}" Margin="14,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background"      Value="{StaticResource PlateBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource ChalkBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource RuleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="9,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
