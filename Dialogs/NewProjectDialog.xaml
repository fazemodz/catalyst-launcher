<Window x:Class="Catalyst_Launcher.Dialogs.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project"
        Width="1040" Height="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontDisplay}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Border Background="{StaticResource BgDeepBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" SnapsToDevicePixels="True">
        <DockPanel LastChildFill="True">

            <!-- ══ TITLEBAR ══ -->
            <Border DockPanel.Dock="Top"
                    Background="#081722"
                    BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,0,0,1"
                    Height="34" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Path Width="16" Height="16" Stretch="None"
                                Data="M2,14 L14,14 L14,2 Z M5.2,12.8 L12.8,12.8 L12.8,5.2 Z"
                                Stroke="{StaticResource BrassBrush}" StrokeThickness="1.2"
                                StrokeLineJoin="Round" SnapsToDevicePixels="True"/>
                        <TextBlock Text="NEW PROJECT" Margin="10,0,0,0"
                                   FontSize="11.5" FontWeight="Bold" FontStretch="SemiCondensed"
                                   Foreground="{StaticResource ChalkBrush}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource TitleCloseBtn}"
                            Click="Close_Click" ToolTip="Close">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══ FOOTER ══ -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FooterTemplateLabel" Text="Blank"
                                   FontFamily="{StaticResource FontMono}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="  /  QUALITY MAXIMUM" FontFamily="{StaticResource FontMono}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                Click="Close_Click" Margin="0,0,10,0"/>
                        <Button x:Name="CreateBtn" Content="Create Project"
                                Style="{StaticResource SuccessButtonV2}"
                                IsEnabled="False" Click="Create_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ BODY ══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Category rail -->
                <Border Grid.Column="0"
                        Background="#0A1C28"
                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="CATEGORY" Style="{StaticResource Caption}" Margin="18,0,0,8"/>
                        <RadioButton Style="{StaticResource CatItem}" GroupName="Cat">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconSheets}"
                                      Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="All" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource CatItem}" GroupName="Cat" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconBox}"
                                      Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="Games" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource CatItem}" GroupName="Cat">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconCamera}"
                                      Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="Film and video" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource CatItem}" GroupName="Cat">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconGrid}"
                                      Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="Visualisation" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource CatItem}" GroupName="Cat">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconFlask}"
                                      Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="Simulation" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Template grid -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="22,22,22,22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Choose a template" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TemplateCountLabel" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                       FontFamily="{StaticResource FontMono}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <ListBox x:Name="TemplateList" ItemsSource="{Binding Templates}"
                                 SelectedIndex="0"
                                 Background="Transparent" BorderThickness="0"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="Template_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin"  Value="0,0,12,12"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Cursor"  Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{StaticResource PlateBrush}"
                                                        BorderBrush="{StaticResource RuleBrush}"
                                                        BorderThickness="1"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{StaticResource SlateBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{StaticResource BrassBrush}"/>
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{StaticResource PlateHiBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Height="72" Background="{Binding Plate}"
                                                BorderBrush="{StaticResource RuleSoftBrush}"
                                                BorderThickness="0,0,0,1"
                                                SnapsToDevicePixels="True">
                                            <TextBlock Text="{Binding Name}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FontMono}" FontSize="11"
                                                       Foreground="{Binding Ink}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Caption}"
                                                   Margin="13,10,13,12"
                                                   FontFamily="{StaticResource FontDisplay}"
                                                   FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                                   Foreground="{StaticResource GraphiteBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Details panel -->
                <Border Grid.Column="2"
                        Background="{StaticResource BgPanelBrush}"
                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,22,22,22">
                        <StackPanel>

                            <TextBlock x:Name="DetailsTitleLabel" Text="Blank"
                                       Margin="0,0,0,6" FontSize="16" FontWeight="Bold"
                                       FontStretch="SemiCondensed"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="DetailsCaptionLabel"
                                       Text="An empty project with no content. Add your own assets, actors, and scripts from scratch."
                                       FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <!-- Project name -->
                            <TextBlock Text="PROJECT NAME" Style="{StaticResource Caption}" Margin="0,18,0,6"/>
                            <TextBox x:Name="ProjectNameInput" Style="{StaticResource DarkTextBox}"
                                     MinHeight="34" TextChanged="NameBox_TextChanged"/>

                            <!-- Location -->
                            <TextBlock Text="LOCATION" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LocationInput" Grid.Column="0"
                                         Style="{StaticResource DarkTextBox}"
                                         MinHeight="34" Margin="0,0,6,0" TextChanged="LocationBox_TextChanged"/>
                                <Button Grid.Column="1" Content="Browse"
                                        Style="{StaticResource GhostButton}"
                                        Click="Browse_Click"/>
                            </Grid>

                            <!-- Quality preset -->
                            <TextBlock Text="QUALITY PRESET" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource SegOpt}" GroupName="Quality" Content="Scalable"/>
                                    <RadioButton Style="{StaticResource SegOpt}" GroupName="Quality" IsChecked="True" Content="Maximum"/>
                                    <RadioButton Style="{StaticResource SegOpt}" GroupName="Quality" Content="Ultra"/>
                                </UniformGrid>
                            </Border>

                            <!-- Features -->
                            <TextBlock Text="FEATURES" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                            <DockPanel Margin="0,4,0,8">
                                <CheckBox DockPanel.Dock="Left" IsChecked="True" VerticalAlignment="Center"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Starter content" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Sample meshes, materials, sounds" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,8">
                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Hardware ray tracing" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Requires DX12 RT-capable GPU" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Path preview -->
                            <Border Margin="0,16,0,0" Padding="12,10"
                                    Background="#071620"
                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                <StackPanel>
                                    <TextBlock Text="PROJECT WILL BE CREATED AT" Style="{StaticResource Caption}" FontSize="8.5"/>
                                    <TextBlock x:Name="PathPreviewLabel" Text="—"
                                               FontFamily="{StaticResource FontMono}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Validation error -->
                            <TextBlock x:Name="ErrorLabel" Margin="0,8,0,0"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="#D2543C"
                                       Visibility="Collapsed"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </DockPanel>
    </Border>
</Window>
