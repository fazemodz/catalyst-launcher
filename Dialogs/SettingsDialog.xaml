<Window x:Class="Catalyst_Launcher.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="800" Height="580"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontDisplay}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Border Background="{StaticResource BgDeepBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" SnapsToDevicePixels="True">
        <DockPanel LastChildFill="True">

            <!-- ══ TITLEBAR ══ -->
            <Border DockPanel.Dock="Top"
                    Background="#081722"
                    BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,0,0,1"
                    Height="34" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Path Width="16" Height="16" Stretch="None"
                                Data="M2,14 L14,14 L14,2 Z M5.2,12.8 L12.8,12.8 L12.8,5.2 Z"
                                Stroke="{StaticResource BrassBrush}" StrokeThickness="1.2"
                                StrokeLineJoin="Round" SnapsToDevicePixels="True"/>
                        <TextBlock Text="SETTINGS" Margin="10,0,0,0"
                                   FontSize="11.5" FontWeight="Bold" FontStretch="SemiCondensed"
                                   Foreground="{StaticResource ChalkBrush}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource TitleCloseBtn}"
                            Click="Close_Click" ToolTip="Close">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ══ BODY ══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Nav sidebar ── -->
                <Border Grid.Column="0"
                        Background="#0A1C28"
                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,14,0,0">

                            <TextBlock Text="PREFERENCES" Style="{StaticResource SidebarSection}"/>
                            <RadioButton x:Name="NavGeneral"
                                         Style="{StaticResource SidebarNav}" GroupName="SettingsNav"
                                         IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconSheets}"
                                          Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="General" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarNav}" GroupName="SettingsNav"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconLayers}"
                                          Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="EDITOR" Style="{StaticResource SidebarSection}"/>
                            <RadioButton Style="{StaticResource SidebarNav}" GroupName="SettingsNav"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconChip}"
                                          Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="Engine" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarNav}" GroupName="SettingsNav"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconBox}"
                                          Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="Build" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarNav}" GroupName="SettingsNav"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconBranch}"
                                          Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="Source Control" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="ACCOUNT" Style="{StaticResource SidebarSection}"/>
                            <RadioButton Style="{StaticResource SidebarNav}" GroupName="SettingsNav"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconUser}"
                                          Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="Profile" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SidebarNav}" GroupName="SettingsNav"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconDiamond}"
                                          Stroke="{StaticResource SlateBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="License" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ── Content area ── -->
                <DockPanel Grid.Column="1" LastChildFill="True" Background="{StaticResource BgDeepBrush}">

                    <!-- Section header -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,0,0,1"
                            Padding="28,16">
                        <StackPanel>
                            <TextBlock x:Name="SectionTitle" Text="General"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="SectionSubtitle" Text="Launcher and project defaults"
                                       FontSize="11" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Footer -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource BgPanelBrush}"
                            BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,1,0,0"
                            Padding="22,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                    Click="Close_Click" Margin="0,0,10,0"/>
                            <Button Content="Save changes" Style="{StaticResource OrangeButton}"
                                    Click="Save_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Content panels — one visible at a time ── -->
                    <Grid>

                        <!-- ════ General ════ -->
                        <ScrollViewer x:Name="PanelGeneral" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="28,24,28,28">

                                <TextBlock Text="ENGINE EXECUTABLE" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EnginePathInput" Grid.Column="0"
                                             Style="{StaticResource DarkTextBox}"
                                             FontFamily="{StaticResource FontMono}" FontSize="12"
                                             MinHeight="34" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="Browse"
                                            Style="{StaticResource GhostButton}"
                                            Click="BrowseEngineExe_Click"/>
                                </Grid>
                                <TextBlock Text="Override the auto-detected Catalyst.exe. Leave blank to search default locations."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}"/>

                                <!-- Divider -->
                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,22,0,0"/>

                                <TextBlock Text="RECENT PROJECTS" Style="{StaticResource Caption}" Margin="0,18,0,7"/>
                                <TextBlock Text="Maximum number of entries to keep in the list:"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,10"/>
                                <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" SnapsToDevicePixels="True" HorizontalAlignment="Left">
                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="MaxRecent5"  Style="{StaticResource SegOpt}"
                                                     GroupName="MaxRecent" Content="5"  Width="52"/>
                                        <RadioButton x:Name="MaxRecent10" Style="{StaticResource SegOpt}"
                                                     GroupName="MaxRecent" Content="10" Width="52"/>
                                        <RadioButton x:Name="MaxRecent20" Style="{StaticResource SegOpt}"
                                                     GroupName="MaxRecent" Content="20" Width="52"/>
                                        <RadioButton x:Name="MaxRecent50" Style="{StaticResource SegOpt}"
                                                     GroupName="MaxRecent" Content="50" Width="52"/>
                                    </UniformGrid>
                                </Border>

                                <!-- Divider -->
                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,22,0,0"/>

                                <TextBlock Text="BEHAVIOR" Style="{StaticResource Caption}" Margin="0,18,0,12"/>
                                <CheckBox x:Name="AutoCloseCheck" Margin="0,0,0,12"
                                          Content="Close launcher automatically when opening a project"/>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ════ Appearance ════ -->
                        <ScrollViewer x:Name="PanelAppearance" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="28,24,28,28">

                                <TextBlock Text="PROJECT GRID" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                                <TextBlock Text="Number of columns in the project grid:"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,10"/>
                                <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" SnapsToDevicePixels="True" HorizontalAlignment="Left">
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="GridCol2" Style="{StaticResource SegOpt}"
                                                     GroupName="GridCols" Content="2" Width="52"/>
                                        <RadioButton x:Name="GridCol3" Style="{StaticResource SegOpt}"
                                                     GroupName="GridCols" Content="3" Width="52"/>
                                        <RadioButton x:Name="GridCol4" Style="{StaticResource SegOpt}"
                                                     GroupName="GridCols" Content="4" Width="52"/>
                                    </UniformGrid>
                                </Border>

                                <!-- Divider -->
                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,22,0,0"/>

                                <TextBlock Text="PROJECT CARDS" Style="{StaticResource Caption}" Margin="0,18,0,12"/>
                                <CheckBox x:Name="ShowMissingCheck" Margin="0,0,0,10"
                                          Content="Show projects that no longer exist (greyed out)"/>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ════ Engine (placeholder) ════ -->
                        <Grid x:Name="PanelEngine" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="40" Height="40" HorizontalAlignment="Center"
                                        Background="{StaticResource FieldBrush}"
                                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconChip}"
                                          Stroke="{StaticResource SlateBrush}"/>
                                </Border>
                                <TextBlock Text="Coming soon"
                                           FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="Engine and renderer settings will be available in a future update."
                                           FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           MaxWidth="280" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- ════ Build (placeholder) ════ -->
                        <Grid x:Name="PanelBuild" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="40" Height="40" HorizontalAlignment="Center"
                                        Background="{StaticResource FieldBrush}"
                                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconBox}"
                                          Stroke="{StaticResource SlateBrush}"/>
                                </Border>
                                <TextBlock Text="Coming soon"
                                           FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="Build and packaging settings will appear here."
                                           FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           MaxWidth="280" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- ════ Source Control (placeholder) ════ -->
                        <Grid x:Name="PanelSourceControl" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="40" Height="40" HorizontalAlignment="Center"
                                        Background="{StaticResource FieldBrush}"
                                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconBranch}"
                                          Stroke="{StaticResource SlateBrush}"/>
                                </Border>
                                <TextBlock Text="Coming soon"
                                           FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="Git and version control integration will appear here."
                                           FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           MaxWidth="280" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- ════ Profile ════ -->
                        <ScrollViewer x:Name="PanelProfile" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="28,24,28,28">

                                <!-- Avatar preview -->
                                <Border Width="64" Height="64"
                                        HorizontalAlignment="Left" Margin="0,0,0,22"
                                        Background="{StaticResource FieldBrush}"
                                        BorderBrush="{StaticResource BrassBrush}" BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <TextBlock x:Name="AvatarInitialText" Text="A"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="26" Foreground="{StaticResource BrassBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="DISPLAY NAME" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                                <TextBox x:Name="DisplayNameInput"
                                         Style="{StaticResource DarkTextBox}"
                                         TextChanged="DisplayNameInput_TextChanged"/>
                                <TextBlock Text="Shown in the launcher sidebar."
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,5,0,0"/>

                                <!-- Divider -->
                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,22,0,0"/>

                                <TextBlock Text="STATUS" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
                                <Border Background="#071620"
                                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" SnapsToDevicePixels="True" Padding="12,9" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="7" Height="7" Fill="#63899F" SnapsToDevicePixels="True"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="OFFLINE / LOCAL"
                                                   FontFamily="{StaticResource FontMono}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Online features are not yet available."
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,6,0,0"/>

                                <!-- Divider -->
                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,22,0,0"/>

                                <TextBlock Text="SESSION" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
                                <Button Content="Log out"
                                        Style="{StaticResource GhostButton}"
                                        Foreground="#D2543C"
                                        BorderBrush="#4A2118"
                                        HorizontalAlignment="Left"
                                        Click="Logout_Click"/>
                                <TextBlock Text="Clears your saved session. You will be asked to sign in next launch."
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="380"/>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ════ License (placeholder) ════ -->
                        <Grid x:Name="PanelLicense" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="40" Height="40" HorizontalAlignment="Center"
                                        Background="{StaticResource FieldBrush}"
                                        BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconDiamond}"
                                          Stroke="{StaticResource SlateBrush}"/>
                                </Border>
                                <TextBlock Text="Coming soon"
                                           FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="License key and activation will be available in a future update."
                                           FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           MaxWidth="280" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </DockPanel>
            </Grid>

        </DockPanel>
    </Border>
</Window>
